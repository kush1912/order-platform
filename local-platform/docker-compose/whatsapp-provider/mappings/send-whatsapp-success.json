{
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPath": "/v1/messages",
    "headers": {
      "Content-Type": {
        "contains": "application/json"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.to"
      },
      {
        "matchesJsonPath": "$.templateName"
      },
      {
        "matchesJsonPath": "$.clientReference"
      }
    ]
  },
  "response": {
    "status": 202,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\"providerMessageId\":\"wa-{{randomValue length=16 type='ALPHANUMERIC'}}\",\"status\":\"ACCEPTED\",\"clientReference\":\"{{jsonPath request.body '$.clientReference'}}\"}",
    "transformers": [
      "response-template"
    ]
  }
}
